# Copier ce fichier vers .env puis adapter les valeurs.
# Ne jamais versionner .env.
#
# macOS :  cp .env.example .env
# Windows : copy .env.example .env

# --- PostgreSQL ---
POSTGRES_USER=pfa_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=pfa_productivity
POSTGRES_HOST=127.0.0.1
# 5433 sur la machine : le port 5432 est souvent déjà pris par un autre PostgreSQL.
# Dans Docker, PostgreSQL continue d'écouter en interne sur 5432.
POSTGRES_PORT=5433

# Utilisée par le backend lancé en local (hors Docker).
# Le service Docker « backend » remplace cette valeur par l'hôte interne « postgres ».
DATABASE_URL=postgresql+psycopg://pfa_user:change_me@127.0.0.1:5433/pfa_productivity

# --- API ---
ENVIRONMENT=development
BACKEND_HOST=0.0.0.0
# 8001 sur la machine : le port 8000 est souvent déjà pris.
# Dans Docker, l'API continue d'écouter en interne sur 8000.
BACKEND_PORT=8001
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend ---
# Laisser vide pour que le navigateur appelle /api sur le serveur Vite,
# qui proxifie vers le backend. Ne pas y placer de secret.
VITE_API_BASE_URL=
FRONTEND_PORT=5173
